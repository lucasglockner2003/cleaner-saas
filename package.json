{
  "name": "cleaner-management-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "db:bundle:pilot": "node scripts/db/build-migration-bundle.mjs --manifest supabase/migrations/bundles/pilot-launch.manifest.json --out supabase/migrations/generated/pilot-launch-bundle.sql",
    "db:staging:migrate": "node scripts/db/staging-migrate.mjs",
    "db:production:migrate": "node scripts/db/production-migrate.mjs",
    "db:staging:reset": "node scripts/db/staging-reset.mjs",
    "db:staging:seed": "node scripts/db/staging-seed.mjs",
    "db:staging:reset-seed": "node scripts/db/staging-reset-seed.mjs",
    "check:env:staging": "node scripts/release/check-release-env.mjs --env-file .env.staging --expected-runtime staging",
    "check:env:production": "node scripts/release/check-release-env.mjs --env-file .env.production --expected-runtime production --strict",
    "deploy:check:staging": "node scripts/release/check-deploy-ready.mjs --environment staging",
    "deploy:check:production": "node scripts/release/check-deploy-ready.mjs --environment production",
    "webhook:stripe:example": "node infra/webhooks/stripe/serverExample.mjs",
    "worker:operations:example": "node infra/workers/operations/runCycleExample.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^5.4.11",
    "vitest": "^4.1.0"
  }
}
